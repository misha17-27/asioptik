# Asioptik: адреса страниц и защита служебных папок
Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Когда на домене включён SSL-сертификат, уберите решётки в трёх строках ниже:
# сайт всегда будет открываться по https
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# служебные папки и файлы с сайта не открываются; так же закрыты архивы и копии базы,
# забытые в папке сайта (например, архив, из которого сайт распаковали)
RewriteRule ^(app|storage)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(md|json|log|sql|sqlite|sh|py|lock|bak|ini|zip|tar|gz|tgz|rar|7z)$ - [NC,F,L]

# существующие файлы и папки отдаются как есть
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# всё остальное — страницы сайта
RewriteRule ^ index.php [L]
</IfModule>

# Фото из админ-панели: где хостинг разрешает, принимаем файлы до 10 МБ (для PHP в режиме FastCGI то же самое задаёт файл .user.ini)
<IfModule mod_php.c>
php_value upload_max_filesize 10M
php_value post_max_size 12M
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"

# Политика Content-Security-Policy этого сайта — та же, что отправляет PHP (она записана в app/core/bootstrap.php).
# Здесь она повторена на случай, когда сайт лежит в папке другого сайта: тот может задавать свою политику
# для всего домена, и она заменила бы нашу — страница осталась бы без данных, шрифтов и фото.
# Эти строки выполняются после строк основного сайта и возвращают политику этого сайта.
# Меняете политику — поменяйте её в обоих местах (и в admin/.htaccess, если речь об админ-панели).
Header always unset Content-Security-Policy
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src https://www.google.com https://maps.google.com https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
<Files "install.php">
Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"
</Files>

<FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
